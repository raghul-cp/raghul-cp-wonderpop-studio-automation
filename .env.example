# Copy this file's variable NAMES into your GitHub repo's Secrets
# (Settings -> Secrets and variables -> Actions -> New repository secret).
# Never commit a real .env file with actual values — this is a template only.

# --- Free script + metadata generation (console.groq.com — no credit card) ---
GROQ_API_KEY=
# Optional, leave blank normally: scripts/common.py already tries several
# model names in order. Only set this to FORCE one specific model.
# Check current free models at https://console.groq.com/docs/models
GROQ_MODEL=

# --- YouTube Data API v3 upload (free quota: ~6 uploads/day) ---
# Obtained once via `python scripts/get_youtube_token.py` on your own
# laptop — see SETUP_GUIDE.md.
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# --- Optional: only needed for the advanced Kaggle video-clip step ---
# Free account + API token from https://www.kaggle.com/settings
KAGGLE_USERNAME=
KAGGLE_KEY=